{
  "name": "propel-csr-backend",
  "version": "0.1.0",
  "description": "Propel CSR Activity Management - backend API (Phase 1 / MVP starter)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "setup": "npm run prisma:generate && npx prisma migrate dev --name init && npm run prisma:seed",
    "deploy:db": "prisma migrate deploy && node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  }
}
